{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "班级积分管理系统",
  "version": "1.8.2",
  "identifier": "com.classscoresystem.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "班级积分管理系统",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "widget",
        "title": "悬浮计分球",
        "url": "widget.html",
        "width": 64,
        "height": 64,
        "minWidth": 64,
        "minHeight": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://picsum.photos; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.github.com https://www.google.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MjZEM0MzNTM4MTFCNEMKUldSTUc0RlR3OU1tVkRZZlBObS91KzBmZVllWlpzY3N6bWNBU3BYUVdCVVRjRGQ5a2VqNWlEQUsK",
      "endpoints": [
        "https://github.com/JiangWanZhengChouYv/PointOS-Public/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "班级小组积分管理",
    "longDescription": "面向教室大屏的班级小组积分管理桌面应用，支持加减分、评比、贡献榜、成员历史、JSON 数据备份和常驻悬浮计分球。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
