{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "班级积分管理系统",
  "version": "1.8.0",
  "identifier": "com.classscoresystem.desktop",
  "build": {
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "班级积分管理系统",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://picsum.photos; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.github.com https://www.google.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "班级小组积分管理",
    "longDescription": "面向教室大屏的班级小组积分管理桌面应用，支持加减分、评比、贡献榜、成员历史和 JSON 数据备份。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
